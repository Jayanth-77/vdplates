<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <radialGradient id="p1-rim-shadow" cx="50%" cy="50%" r="50%">
      <stop offset="60%" stopColor="#000000" stopOpacity="0" />
      <stop offset="88%" stopColor="#0f2e08" stopOpacity="0.45" />
      <stop offset="100%" stopColor="#051503" stopOpacity="0.75" />
    </radialGradient>
    <linearGradient id="p1-glaze" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#ffffff" stopOpacity="0.4" />
      <stop offset="30%" stopColor="#ffffff" stopOpacity="0.05" />
      <stop offset="70%" stopColor="#000000" stopOpacity="0.1" />
      <stop offset="100%" stopColor="#ffffff" stopOpacity="0.2" />
    </linearGradient>
    <pattern id="monstera-leaf-pattern" width="130" height="130" patternUnits="userSpaceOnUse">
      <rect width="130" height="130" fill="#a0d86b"/>
      <!-- Leaf 1 -->
      <path d="M65 15 C40 5, 12 30, 25 70 C35 90, 65 115, 65 120 C65 115, 95 90, 105 70 C118 30, 90 5, 65 15 Z" fill="#6eb738" stroke="#265b12" stroke-width="2.5"/>
      <path d="M65 20 L65 115" stroke="#204d0f" stroke-width="2"/>
      <path d="M65 40 Q40 30 30 45 M65 40 Q90 30 100 45" stroke="#204d0f" stroke-width="1.8" fill="none"/>
      <path d="M65 60 Q38 52 32 70 M65 60 Q92 52 98 70" stroke="#204d0f" stroke-width="1.8" fill="none"/>
      <path d="M65 80 Q42 75 38 90 M65 80 Q88 75 92 90" stroke="#204d0f" stroke-width="1.8" fill="none"/>
      <!-- Leaf 2 corner -->
      <path d="M5 10 C-10 0, -5 35, 10 45 C18 42, 22 20, 5 10 Z" fill="#82cb4b" stroke="#265b12" stroke-width="1.5"/>
      <path d="M125 120 C140 130, 135 95, 120 85 C112 88, 108 110, 125 120 Z" fill="#82cb4b" stroke="#265b12" stroke-width="1.5"/>
    </pattern>
  </defs>
  <rect width="500" height="500" fill="#ffffff" opacity="0"/>
  <!-- Outer deep tray -->
  <rect x="30" y="30" width="440" height="440" rx="60" fill="url(#monstera-leaf-pattern)" stroke="#1d460d" stroke-width="4"/>
  <rect x="30" y="30" width="440" height="440" rx="60" fill="url(#p1-rim-shadow)"/>
  <!-- Inner dish depression -->
  <rect x="85" y="85" width="330" height="330" rx="40" fill="url(#monstera-leaf-pattern)"/>
  <rect x="85" y="85" width="330" height="330" rx="40" fill="none" stroke="#16370a" stroke-width="4" opacity="0.5"/>
  <rect x="88" y="88" width="324" height="324" rx="38" fill="none" stroke="#e5fab8" stroke-width="2" opacity="0.6"/>
  <!-- Shine -->
  <rect x="30" y="30" width="440" height="440" rx="60" fill="url(#p1-glaze)"/>
</svg>