<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <radialGradient id="p2-depth" cx="50%" cy="50%" r="50%">
      <stop offset="65%" stopColor="#000000" stopOpacity="0" />
      <stop offset="85%" stopColor="#12360b" stopOpacity="0.4" />
      <stop offset="100%" stopColor="#061704" stopOpacity="0.75" />
    </radialGradient>
    <linearGradient id="p2-glaze" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#ffffff" stopOpacity="0.4" />
      <stop offset="30%" stopColor="#ffffff" stopOpacity="0.05" />
      <stop offset="70%" stopColor="#000000" stopOpacity="0.15" />
      <stop offset="100%" stopColor="#ffffff" stopOpacity="0.2" />
    </linearGradient>
    <pattern id="monstera-round-pattern" width="130" height="130" patternUnits="userSpaceOnUse">
      <rect width="130" height="130" fill="#a0d86b"/>
      <path d="M65 15 C40 5, 12 30, 25 70 C35 90, 65 115, 65 120 C65 115, 95 90, 105 70 C118 30, 90 5, 65 15 Z" fill="#6eb738" stroke="#265b12" stroke-width="2.5"/>
      <path d="M65 20 L65 115" stroke="#204d0f" stroke-width="2"/>
      <path d="M65 40 Q40 30 30 45 M65 40 Q90 30 100 45" stroke="#204d0f" stroke-width="1.8" fill="none"/>
      <path d="M65 60 Q38 52 32 70 M65 60 Q92 52 98 70" stroke="#204d0f" stroke-width="1.8" fill="none"/>
      <path d="M65 80 Q42 75 38 90 M65 80 Q88 75 92 90" stroke="#204d0f" stroke-width="1.8" fill="none"/>
    </pattern>
  </defs>
  <!-- Crimped Round Plate Edge -->
  <circle cx="250" cy="250" r="225" fill="url(#monstera-round-pattern)" stroke="#193c0d" stroke-width="4"/>
  <circle cx="250" cy="250" r="225" fill="url(#p2-depth)"/>
  <circle cx="250" cy="250" r="175" fill="url(#monstera-round-pattern)"/>
  <circle cx="250" cy="250" r="175" fill="none" stroke="#133109" stroke-width="4" opacity="0.4"/>
  <circle cx="250" cy="250" r="173" fill="none" stroke="#e5fab8" stroke-width="2" opacity="0.6"/>
  <circle cx="250" cy="250" r="225" fill="url(#p2-glaze)"/>
</svg>