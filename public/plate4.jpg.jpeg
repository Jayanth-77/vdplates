      <stop offset="48%" stopColor="#3d9e21" />
      <stop offset="50%" stopColor="#e2f0d9" />
      <stop offset="52%" stopColor="#3d9e21" />
      <stop offset="100%" stopColor="#2e7d17" />
    </linearGradient>
    <linearGradient id="p4-glaze" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stopColor="#ffffff" stopOpacity="0.4" />
      <stop offset="30%" stopColor="#ffffff" stopOpacity="0.05" />
      <stop offset="70%" stopColor="#000000" stopOpacity="0.1" />
      <stop offset="100%" stopColor="#ffffff" stopOpacity="0.2" />
    </linearGradient>
  </defs>
  <rect x="30" y="30" width="440" height="440" rx="55" fill="url(#p4-leaf-bg)" stroke="#19430c" stroke-width="4"/>
